<!DOCTYPE html>
<html lang="ru" class="{{ 'dark' if theme == 'dark' else '' }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ business_name }}{% if city %} — {{ city }}{% endif %}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --accent:{{ accent }};
    --accent-2:color-mix(in srgb, var(--accent), #7c5cff 50%);
    --accent-ink:#ffffff;
    --accent-soft:color-mix(in srgb, var(--accent) 12%, #ffffff);
    --bg:#ffffff; --bg-soft:#f6f7fb;
    --text:#14151a; --muted:#63666e;
    --border:#eceef3; --border-strong:#e0e3ea;
    --card:#ffffff;
    --c-blue:#eef2ff;--c-blue-ink:#4f6ef7; --c-green:#e9f8f0;--c-green-ink:#1f9d66;
    --c-amber:#fff4e6;--c-amber-ink:#d98613; --c-violet:#f3edff;--c-violet-ink:#7c5cff;
    --c-pink:#ffeef4;--c-pink-ink:#e0568a;
    --radius:22px; --container:1140px;
    --ease:cubic-bezier(.2,.7,.2,1);
    --shadow:0 10px 30px rgba(20,21,26,.06); --shadow-lg:0 18px 50px rgba(20,21,26,.10);
  }
  :root.dark{
    --accent-soft:color-mix(in srgb, var(--accent) 22%, transparent);
    --bg:#0b0b0d; --bg-soft:#141417;
    --text:#f4f4f5; --muted:#9b9ba3;
    --border:rgba(255,255,255,.08); --border-strong:rgba(255,255,255,.16);
    --card:#141417;
    --shadow:0 10px 30px rgba(0,0,0,.3); --shadow-lg:0 18px 50px rgba(0,0,0,.45);
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{background:var(--bg);color:var(--text);
    font-family:'Manrope',system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
    line-height:1.55;-webkit-font-smoothing:antialiased;overflow-x:hidden}
  .container{max-width:var(--container);margin:0 auto;padding:0 24px}
  a{color:inherit;text-decoration:none}
  section{padding:100px 0}
  h1,h2,h3{letter-spacing:-.03em;line-height:1.06;font-weight:800}
  h2{font-size:clamp(2rem,4.5vw,3.1rem)}
  .lead{color:var(--muted);font-size:1.12rem;max-width:560px}
  .eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:.8rem;font-weight:700;
    letter-spacing:.06em;text-transform:uppercase;color:var(--accent);
    padding:7px 14px;border-radius:100px;background:var(--accent-soft)}
  .btn{display:inline-flex;align-items:center;gap:9px;padding:14px 26px;border-radius:100px;
    font-weight:700;font-size:.98rem;cursor:pointer;border:1px solid transparent;
    transition:transform .25s var(--ease),box-shadow .25s var(--ease),background .2s,border-color .2s}
  .btn-primary{background:var(--accent);color:var(--accent-ink);box-shadow:0 8px 20px color-mix(in srgb,var(--accent) 35%,transparent)}
  .btn-primary:hover{transform:translateY(-2px)}
  .btn-ghost{background:var(--card);color:var(--text);border-color:var(--border-strong)}
  .btn-ghost:hover{border-color:var(--accent);color:var(--accent)}
  .icon{width:20px;height:20px;flex:none}

  header{position:sticky;top:0;z-index:50;background:color-mix(in srgb,var(--bg) 82%,transparent);
    backdrop-filter:blur(14px);border-bottom:1px solid var(--border)}
  .nav{display:flex;align-items:center;justify-content:space-between;height:74px}
  .logo{display:flex;align-items:center;gap:10px;font-weight:800;font-size:1.15rem}
  .logo .dot{width:32px;height:32px;border-radius:11px;background:var(--accent);
    display:grid;place-items:center;color:#fff}
  .nav-links{display:flex;gap:32px}
  .nav-links a{color:var(--muted);font-size:.95rem;font-weight:600;transition:color .2s}
  .nav-links a:hover{color:var(--text)}
  .burger{display:none;background:var(--card);border:1px solid var(--border-strong);border-radius:12px;padding:9px;color:var(--text)}

  .hero{position:relative;padding:96px 0 70px;text-align:center;overflow:hidden}
  .hero::before{content:"";position:absolute;top:-140px;left:50%;transform:translateX(-50%);
    width:900px;height:520px;z-index:0;pointer-events:none;
    background:radial-gradient(closest-side,color-mix(in srgb,var(--accent) 16%,transparent),transparent),
               radial-gradient(closest-side,color-mix(in srgb,var(--accent-2) 12%,transparent),transparent);
    background-position:35% 30%,70% 40%;background-repeat:no-repeat}
  .hero .inner{position:relative;z-index:1;max-width:760px;margin:0 auto}
  .hero h1{font-size:clamp(2.6rem,7vw,4.4rem);margin:22px 0 18px}
  .hero h1 .accent{color:var(--accent)}
  .hero .lead{margin:0 auto}
  .hero-cta{display:flex;gap:14px;margin-top:34px;justify-content:center;flex-wrap:wrap}
  .pills{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:34px}
  .pill{display:flex;align-items:center;gap:8px;background:var(--card);border:1px solid var(--border);
    border-radius:100px;padding:9px 16px;font-size:.9rem;color:var(--muted);box-shadow:var(--shadow)}
  .pill .icon{width:17px;height:17px;color:var(--accent)}

  .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:20px}
  .stat{background:var(--bg-soft);border:1px solid var(--border);border-radius:var(--radius);padding:26px;text-align:center}
  .stat .num{font-size:clamp(1.8rem,4vw,2.6rem);font-weight:800;letter-spacing:-.03em;color:var(--accent)}
  .stat .lbl{color:var(--muted);font-size:.95rem;margin-top:4px}

  .section-head{max-width:640px;margin:0 auto 52px;text-align:center}
  .section-head h2{margin:16px 0 14px}
  .section-head .lead{margin:0 auto}
  .bento{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
  .card{border-radius:var(--radius);padding:30px;background:var(--card);border:1px solid var(--border);
    box-shadow:var(--shadow);transition:transform .3s var(--ease),box-shadow .3s var(--ease)}
  .card:hover{transform:translateY(-6px);box-shadow:var(--shadow-lg)}
  .card .ic{width:52px;height:52px;border-radius:15px;display:grid;place-items:center;margin-bottom:20px}
  .card .ic .icon{width:24px;height:24px}
  .card h3{font-size:1.25rem;margin-bottom:8px}
  .card p{color:var(--muted);font-size:.98rem}
  .card .price{margin-top:18px;font-weight:800;font-size:1.05rem}
  .card.wide{grid-column:span 2}
  .t-blue .ic{background:var(--c-blue);color:var(--c-blue-ink)} .t-blue .price{color:var(--c-blue-ink)}
  .t-green .ic{background:var(--c-green);color:var(--c-green-ink)} .t-green .price{color:var(--c-green-ink)}
  .t-amber .ic{background:var(--c-amber);color:var(--c-amber-ink)} .t-amber .price{color:var(--c-amber-ink)}
  .t-violet .ic{background:var(--c-violet);color:var(--c-violet-ink)} .t-violet .price{color:var(--c-violet-ink)}
  .t-pink .ic{background:var(--c-pink);color:var(--c-pink-ink)} .t-pink .price{color:var(--c-pink-ink)}
  .card.wide.t-blue{background:linear-gradient(135deg,var(--c-blue),var(--card))}
  :root.dark .card .ic{background:var(--accent-soft)!important;color:var(--accent)!important}
  :root.dark .card .price{color:var(--accent)!important}
  :root.dark .card.wide.t-blue{background:linear-gradient(135deg,#1a1a1f,var(--card))}

  .about{background:var(--bg-soft)}
  .about-grid{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center}
  .about-grid .lead{margin-top:16px}
  .about-visual{background:linear-gradient(135deg,var(--accent),var(--accent-2));border-radius:var(--radius);
    min-height:320px;display:grid;place-items:center;color:#fff;box-shadow:var(--shadow-lg);position:relative;overflow:hidden}
  .about-visual .big{font-size:clamp(3rem,10vw,6rem);font-weight:800;letter-spacing:-.04em;opacity:.92;padding:0 10px;text-align:center}
  .about-visual::after{content:"";position:absolute;width:260px;height:260px;border-radius:50%;
    background:rgba(255,255,255,.12);top:-60px;right:-60px}

  .quotes{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
  .quote{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:28px;box-shadow:var(--shadow)}
  .stars{color:#f5a524;margin-bottom:14px;letter-spacing:2px}
  .quote p{font-size:1rem;margin-bottom:20px}
  .quote .who{display:flex;align-items:center;gap:12px}
  .quote .av{width:42px;height:42px;border-radius:50%;display:grid;place-items:center;
    background:var(--accent-soft);color:var(--accent);font-weight:800}
  .quote .who b{font-weight:700;font-size:.95rem}
  .quote .who small{color:var(--muted);display:block;font-size:.85rem}

  .cta .box{background:linear-gradient(135deg,var(--accent),var(--accent-2));border-radius:32px;
    padding:70px 30px;text-align:center;color:#fff;box-shadow:var(--shadow-lg);position:relative;overflow:hidden}
  .cta .box::before{content:"";position:absolute;width:340px;height:340px;border-radius:50%;
    background:rgba(255,255,255,.10);top:-120px;left:-80px}
  .cta .box::after{content:"";position:absolute;width:280px;height:280px;border-radius:50%;
    background:rgba(255,255,255,.10);bottom:-120px;right:-60px}
  .cta h2{position:relative;z-index:1;margin-bottom:14px}
  .cta p{position:relative;z-index:1;opacity:.92;max-width:520px;margin:0 auto 28px;font-size:1.1rem}
  .cta .btn{position:relative;z-index:1;background:#fff;color:var(--accent)}
  .cta .btn:hover{transform:translateY(-2px)}

  footer{border-top:1px solid var(--border);padding:56px 0 40px}
  .foot{display:flex;justify-content:space-between;gap:40px;flex-wrap:wrap}
  .foot .contacts{display:flex;flex-direction:column;gap:14px}
  .foot .contacts a,.foot .contacts span{display:flex;align-items:center;gap:12px;color:var(--muted);font-size:.97rem}
  .foot .contacts a:hover{color:var(--accent)}
  .foot .contacts .icon{color:var(--accent)}
  .copy{margin-top:36px;color:var(--muted);font-size:.85rem}

  @media(max-width:860px){
    section{padding:72px 0}
    .nav-links{display:none}.burger{display:grid;place-items:center}
    .stats,.bento,.quotes,.about-grid{grid-template-columns:1fr}
    .card.wide{grid-column:span 1}
  }
</style>
</head>
<body>

<header>
  <div class="container nav">
    <div class="logo"><span class="dot">{{ logo_icon|safe }}</span>{{ business_name }}</div>
    <nav class="nav-links">
      <a href="#services">Услуги</a>
      <a href="#about">О нас</a>
      {% if reviews %}<a href="#reviews">Отзывы</a>{% endif %}
      <a href="#contacts">Контакты</a>
    </nav>
    <a href="{{ wa_link }}" class="btn btn-primary" style="padding:11px 20px">Записаться</a>
    <button class="burger" aria-label="Меню">{{ burger_icon|safe }}</button>
  </div>
</header>

<section class="hero">
  <div class="container inner">
    <span class="eyebrow">{{ eyebrow }}</span>
    <h1>{{ hero_title_prefix }} <span class="accent">{{ hero_title_accent }}</span></h1>
    <p class="lead">{{ hero_subtitle }}</p>
    <div class="hero-cta">
      <a href="{{ wa_link }}" class="btn btn-primary">{{ wa_icon|safe }} Записаться в WhatsApp</a>
      <a href="#services" class="btn btn-ghost">Услуги и цены</a>
    </div>
    <div class="pills">
      {% for p in pills %}<span class="pill">{{ p.icon|safe }}{{ p.text }}</span>{% endfor %}
    </div>
  </div>
</section>

<div class="container">
  <div class="stats">
    {% for s in stats %}<div class="stat"><div class="num">{{ s.num }}</div><div class="lbl">{{ s.label }}</div></div>{% endfor %}
  </div>
</div>

<section id="services">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Услуги</span>
      <h2>{{ services_title }}</h2>
      <p class="lead">{{ services_subtitle }}</p>
    </div>
    <div class="bento">
      {% for s in services %}
      <div class="card {{ s.tone }}{% if loop.first %} wide{% endif %}">
        <div class="ic">{{ s.icon|safe }}</div>
        <h3>{{ s.name }}</h3>
        <p>{{ s.description }}</p>
        {% if s.price %}<div class="price">{{ s.price }}</div>{% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section id="about" class="about">
  <div class="container about-grid">
    <div>
      <span class="eyebrow">О нас</span>
      <h2>{{ about_title }}</h2>
      <p class="lead">{{ about_text }}</p>
    </div>
    <div class="about-visual"><div class="big">{{ business_name }}</div></div>
  </div>
</section>

{% if reviews %}
<section id="reviews">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Отзывы</span>
      <h2>{{ reviews_title }}</h2>
    </div>
    <div class="quotes">
      {% for r in reviews %}
      <div class="quote">
        <div class="stars">{{ r.stars }}</div>
        <p>«{{ r.text }}»</p>
        <div class="who"><div class="av">{{ r.initial }}</div><div><b>{{ r.author }}</b><small>{{ r.subtitle }}</small></div></div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section class="cta">
  <div class="container">
    <div class="box">
      <h2>{{ cta_title }}</h2>
      <p>{{ cta_text }}</p>
      <a href="{{ wa_link }}" class="btn">{{ wa_icon|safe }} Записаться сейчас</a>
    </div>
  </div>
</section>

<footer id="contacts">
  <div class="container foot">
    <div>
      <div class="logo" style="margin-bottom:16px"><span class="dot">{{ logo_icon|safe }}</span>{{ business_name }}</div>
      <p class="lead" style="font-size:.97rem">{{ footer_tagline }}</p>
    </div>
    <div class="contacts">
      <a href="{{ wa_link }}">{{ wa_icon|safe }}{{ phone or wa_display }}</a>
      {% if address %}<span>{{ pin_icon|safe }}{{ address }}</span>{% endif %}
      {% if hours %}<span>{{ clock_icon|safe }}{{ hours }}</span>{% endif %}
    </div>
  </div>
  <div class="container copy">© {{ year }} {{ business_name }}{% if city %} · {{ city }}{% endif %}</div>
</footer>

</body>
</html>
