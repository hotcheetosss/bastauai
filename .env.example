# ================================================
# Скопируй этот файл в .env и впиши реальные значения.
# .env НЕ коммитится в git (см. .gitignore).
# ================================================

# --- Supabase (CRM) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=          # service_role key — только для бэкенда, НЕ для фронта
SUPABASE_ANON_KEY=             # публичный ключ (если понадобится)

# --- Claude API (ИИ-агенты) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- GREEN-API (WhatsApp) ---
GREENAPI_ID_INSTANCE=
GREENAPI_API_TOKEN=

# --- Деплой сайтов (агент №2) ---
NETLIFY_AUTH_TOKEN=
# или
VERCEL_TOKEN=

# --- Уведомления менеджеру (handoff to human) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=
