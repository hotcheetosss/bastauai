# ================================================
# Скопируй этот файл в .env и впиши реальные значения
# ПОСЛЕ знака = , без пробелов, без комментариев в той же строке.
# .env НЕ коммитится в git (см. .gitignore).
# ================================================

# --- Supabase (CRM) ---
# Project URL со страницы проекта
SUPABASE_URL=https://your-project.supabase.co
# service_role / secret key (Project Settings -> API Keys). СЕКРЕТ, только для бэкенда!
SUPABASE_SERVICE_KEY=
# публичный anon/publishable ключ (если понадобится фронту)
SUPABASE_ANON_KEY=

# --- Генератор сайтов: gemini (бесплатный старт) или claude ---
GENERATOR=gemini

# --- Gemini (Google AI Studio: aistudio.google.com -> Get API key) ---
GEMINI_API_KEY=

# --- Claude API (ИИ-агенты; для генератора нужен только если GENERATOR=claude) ---
ANTHROPIC_API_KEY=

# --- GREEN-API (WhatsApp) ---
GREENAPI_ID_INSTANCE=
GREENAPI_API_TOKEN=
# API-хост из консоли GREEN-API (напр. https://7105.api.greenapi.com); дефолт ниже
GREENAPI_API_URL=https://api.green-api.com

# --- Деплой сайтов (агент №2) ---
NETLIFY_AUTH_TOKEN=
VERCEL_TOKEN=

# --- Уведомления менеджеру (handoff to human) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=
